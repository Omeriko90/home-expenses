// Home Expenses & Investments — data model
// See /Users/omerdomb/.claude/plans/i-want-to-create-goofy-newt.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum CategoryType {
  EXPENSE
  INVESTMENT
}

enum TxKind {
  FIXED
  VARIABLE
}

enum PortfolioGroup {
  MAIN
  KIDS
}

enum MappingMatch {
  EXACT
  CONTAINS
}

enum GoalType {
  NUMERIC
  CHECKLIST
}

enum GoalLinkKind {
  NONE
  CATEGORY
  INVESTMENT_TOTAL
}

// A household is the tenancy boundary — all finance data belongs to one.
model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users            User[]
  invitations      Invitation[]
  categories       Category[]
  transactions     Transaction[]
  portfolios       Portfolio[]
  goals            Goal[]
  businessMappings BusinessMapping[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Sessions issued before this instant are rejected (see lib/session.ts).
  passwordChangedAt DateTime?
  locale       String   @default("he") // "he" | "en"
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  transactions        Transaction[]
  sentInvitations     Invitation[]         @relation("InvitationInviter")
  passwordResetTokens PasswordResetToken[]
}

// Pending invite to join a household. The opaque token is the only thing that
// travels in the invite link; email/household/role resolve server-side. Only a
// sha256 of the token is stored (same scheme as PasswordResetToken).
model Invitation {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique
  role       Role      @default(MEMBER)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  invitedById String?
  invitedBy   User?   @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([householdId, email])
}

// Single-use, short-lived tokens for the forgot-password flow.
// Only a sha256 of the token is stored; the raw token lives in the emailed link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Shared category model — `type` distinguishes expense vs investment categories.
model Category {
  id          String       @id @default(cuid())
  name        String
  nameEn      String?
  description String?
  type        CategoryType @default(EXPENSE)
  color       String?
  archived    Boolean      @default(false)
  sortOrder   Int          @default(0)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  transactions    Transaction[]
  budgets         Budget[]
  businessMapping BusinessMapping[]
  linkedGoals     Goal[]            @relation("GoalLinkedCategory")

  @@unique([householdId, name])
  @@index([householdId, type])
}

model Transaction {
  id              String   @id @default(cuid())
  date            DateTime
  businessName    String
  amount          Decimal  @db.Decimal(12, 2)
  kind            TxKind   @default(VARIABLE)
  rawBusinessName String? // original, pre-normalization
  rawFileCategory String? // card-issuer category from the imported file (reference)
  year            Int // denormalized for fast summary queries
  month           Int // 1-12
  note            String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id])

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([householdId, year, month])
  @@index([categoryId, year])
}

// Learned business -> category mappings (the import "learner").
model BusinessMapping {
  id        String       @id @default(cuid())
  pattern   String // normalized business string
  matchType MappingMatch @default(EXACT)
  hitCount  Int          @default(1)
  updatedAt DateTime     @updatedAt

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([householdId, pattern])
}

model Budget {
  id            String  @id @default(cuid())
  year          Int
  monthlyAmount Decimal @db.Decimal(12, 2) // yearly computed = monthlyAmount * 12

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, year])
}

model Portfolio {
  id        String         @id @default(cuid())
  name      String
  group     PortfolioGroup @default(MAIN)
  sortOrder Int            @default(0)
  archived  Boolean        @default(false)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  holdings       Holding[]
  years          PortfolioYear[]

  @@unique([householdId, name, group])
}

model Holding {
  id         String @id @default(cuid())
  channel    String // אפיק
  instrument String // מכשיר
  house      String // בית השקעות
  sortOrder  Int    @default(0)

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  snapshots HoldingSnapshot[]
}

model PortfolioYear {
  id       String  @id @default(cuid())
  year     Int
  deposits Decimal @db.Decimal(14, 2)

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, year])
}

model HoldingSnapshot {
  id    String  @id @default(cuid())
  year  Int
  value Decimal @db.Decimal(14, 2)

  holdingId String
  holding   Holding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@unique([holdingId, year])
}

model Goal {
  id    String   @id @default(cuid())
  title String
  year  Int
  type  GoalType @default(NUMERIC)
  note  String?

  // NUMERIC
  targetAmount  Decimal?     @db.Decimal(14, 2)
  currentAmount Decimal?     @db.Decimal(14, 2)
  linkKind      GoalLinkKind @default(NONE)

  linkCategoryId String?
  linkCategory   Category? @relation("GoalLinkedCategory", fields: [linkCategoryId], references: [id])

  // CHECKLIST
  milestones GoalMilestone[]

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([householdId, year])
}

model GoalMilestone {
  id        String  @id @default(cuid())
  title     String
  done      Boolean @default(false)
  sortOrder Int     @default(0)

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
}
